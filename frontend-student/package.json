{
  "name": "proctora-frontend-student",
  "private": true,
  "version": "2.1.3",
  "author": "Ankit Talukder",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "build:ai": "node ../scripts/build-ai-binary.js",
    "build:mac": "npm run build && npx electron-builder --mac",
    "build:mac:all": "npm run build:ai && npm run build && npx electron-builder --mac",
    "build:win": "npm run build && npx electron-builder --win --x64",
    "build:win:all": "npm run build:ai && npm run build && npx electron-builder --win --x64",
    "build:win:arm64": "npm run build && npx electron-builder --win --arm64",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.363.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.proctora.student",
    "productName": "Proctora Student",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/.*",
      "!**/._*"
    ],
    "extraResources": [
      {
        "from": "../ai-engine/dist/proctora-ai",
        "to": "proctora-ai",
        "filter": [
          "**/*",
          "!**/._*",
          "!**/.*"
        ]
      }
    ],
    "asar": false,
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.icns",
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proctora Student",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
